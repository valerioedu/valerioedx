#ifndef STRING
#define STRING

#include <utility>
#include <stddef.h>

namespace std {

    class string {
    private:
        char* data_;
        size_t size_;
        size_t capacity_;

        void init_from_cstr(const char* str, size_t len) {
            size_ = len;
            capacity_ = size_ + 1;
            data_ = new char[capacity_];
            for (size_t i = 0; i < size_; ++i) {
                data_[i] = str[i];
            }

            data_[size_] = '\0';
        }

    public:
        string() : size_(0), capacity_(1) {
            data_ = new char[1];
            data_[0] = '\0';
        }

        string(const char* str) {
            size_t len = 0;
            while (str[len] != '\0') ++len;
            init_from_cstr(str, len);
        }

        ~string() {
            delete[] data_;
        }

        string(const string& other) {
            init_from_cstr(other.data_, other.size_);
        }

        string& operator=(const string& other) {
            if (this != &other) {
                delete[] data_;
                init_from_cstr(other.data_, other.size_);
            }

            return *this;
        }

        string& operator=(const char* str) {
            size_t len = 0;
            while (str[len] != '\0') ++len;
            delete[] data_;
            init_from_cstr(str, len);
            return *this;
        }

        string(string&& other) noexcept : data_(other.data_), size_(other.size_), capacity_(other.capacity_) {
            other.data_ = new char[1];
            other.data_[0] = '\0';
            other.size_ = 0;
            other.capacity_ = 1;
        }

        string& operator=(string&& other) noexcept {
            if (this != &other) {
                delete[] data_;
                data_ = other.data_;
                size_ = other.size_;
                capacity_ = other.capacity_;
                
                other.data_ = new char[1];
                other.data_[0] = '\0';
                other.size_ = 0;
                other.capacity_ = 1;
            }

            return *this;
        }

        size_t size() const { return size_; }
        size_t length() const { return size_; }
        size_t capacity() const { return capacity_; }
        bool empty() const { return size_ == 0; }

        void reserve(size_t new_cap) {
            if (new_cap > capacity_) {
                char* new_data = new char[new_cap];
                for (size_t i = 0; i < size_ + 1; ++i) {
                    new_data[i] = data_[i];
                }

                delete[] data_;
                data_ = new_data;
                capacity_ = new_cap;
            }
        }

        void clear() {
            size_ = 0;
            data_[0] = '\0';
        }

        void push_back(char c) {
            if (size_ + 1 >= capacity_) {
                reserve(capacity_ == 0 ? 2 : capacity_ * 2);
            }

            data_[size_] = c;
            size_++;
            data_[size_] = '\0';
        }

        string& operator+=(char c) {
            push_back(c);
            return *this;
        }

        string& operator+=(const string& str) {
            reserve(size_ + str.size_ + 1);
            for (size_t i = 0; i < str.size_; ++i) {
                data_[size_ + i] = str.data_[i];
            }

            size_ += str.size_;
            data_[size_] = '\0';
            return *this;
        }

        string& operator+=(const char* str) {
            size_t len = 0;
            while (str[len] != '\0') ++len;
            reserve(size_ + len + 1);
            for (size_t i = 0; i < len; ++i) {
                data_[size_ + i] = str[i];
            }

            size_ += len;
            data_[size_] = '\0';
            return *this;
        }

        const char* c_str() const { return data_; }
        const char* data() const { return data_; }

        char& operator[](size_t pos) { return data_[pos]; }
        const char& operator[](size_t pos) const { return data_[pos]; }

        bool operator==(const string& other) const {
            if (size_ != other.size_) return false;
            for (size_t i = 0; i < size_; ++i) {
                if (data_[i] != other.data_[i]) return false;
            }

            return true;
        }

        bool operator==(const char* other) const {
            size_t i = 0;
            while (other[i] != '\0' && i < size_) {
                if (data_[i] != other[i]) return false;
                ++i;
            }
    
            return size_ == i && other[i] == '\0';
        }

        bool operator!=(const string& other) const { return !(*this == other); }
        bool operator!=(const char* other) const { return !(*this == other); }
    };

}

#endif